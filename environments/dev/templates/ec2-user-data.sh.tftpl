#!/bin/bash
# 개발 EC2에서 Compose 기반 BE·AI·Caddy runtime을 안전하게 초기화한다.
set -euo pipefail
umask 077

LANDIT_DIR="/opt/landit"
BIN_DIR="$${LANDIT_DIR}/bin"
RUNTIME_DIR="/run/landit"
AWS_REGION="${aws_region}"
SSM_PATH="${parameter_store_path}"
ECR_REGISTRY="${ecr_registry}"
API_IMAGE="${api_image}"
AI_IMAGE="${ai_image}"
LOCK_FILE="$${LANDIT_LOCK_FILE:-/var/lock/landit-deploy.lock}"

exec 9>"$${LOCK_FILE}"
flock -x 9

dnf install -y docker jq curl amazon-cloudwatch-agent
install -d -m 0755 "$${LANDIT_DIR}" "$${BIN_DIR}"
install -d -m 0700 "$${RUNTIME_DIR}"
install -d -m 0755 /usr/local/lib/docker/cli-plugins
curl -fsSL "https://github.com/docker/compose/releases/download/v2.29.7/docker-compose-linux-x86_64" \
  -o /usr/local/lib/docker/cli-plugins/docker-compose
printf '%s  %s\n' \
  '383ce6698cd5d5bbf958d2c8489ed75094e34a77d340404d9f32c4ae9e12baf0' \
  '/usr/local/lib/docker/cli-plugins/docker-compose' | sha256sum --check --status
chmod 0755 /usr/local/lib/docker/cli-plugins/docker-compose
systemctl enable --now docker

if ! swapon --show=NAME | grep -q '^/swapfile$'; then
  fallocate -l 2G /swapfile
  chmod 0600 /swapfile
  mkswap /swapfile
  swapon /swapfile
fi
if ! grep -q '^/swapfile swap swap defaults 0 0$' /etc/fstab; then
  echo '/swapfile swap swap defaults 0 0' >> /etc/fstab
fi

cat > "$${LANDIT_DIR}/compose.yml" <<'COMPOSE'
${docker_compose}
COMPOSE

cat > "$${LANDIT_DIR}/Caddyfile" <<'CADDY'
${caddyfile}
CADDY

if [[ ! -s "$${LANDIT_DIR}/api.tag" ]]; then
  printf '%s\n' latest > "$${LANDIT_DIR}/api.tag"
fi
if [[ ! -s "$${LANDIT_DIR}/ai.tag" ]]; then
  printf '%s\n' latest > "$${LANDIT_DIR}/ai.tag"
fi
cat > "$${LANDIT_DIR}/images.env" <<EOF
API_IMAGE=$${API_IMAGE}
AI_IMAGE=$${AI_IMAGE}
API_TAG=$(cat "$${LANDIT_DIR}/api.tag")
AI_TAG=$(cat "$${LANDIT_DIR}/ai.tag")
EOF
chmod 0644 "$${LANDIT_DIR}/images.env"

cat > "$${BIN_DIR}/runtime-env" <<'RUNTIME_ENV'
#!/bin/bash
# SSM runtime 값을 root 전용 Compose env 파일로 갱신한다.
set -euo pipefail
umask 077

AWS_REGION="${aws_region}"
SSM_PATH="${parameter_store_path}"
RUNTIME_DIR="/run/landit"
ENVIRONMENT="${environment}"
APP_BUCKET_NAME="${app_bucket_name}"
JOBS_QUEUE_URL="${jobs_queue_url}"
GRAFANA_OTLP_ENABLED="${grafana_otlp_enabled}"
GRAFANA_OTLP_ENDPOINT="${grafana_otlp_endpoint}"

write_ssm_env() {
  local destination="$1"
  shift
  local expected_parameters
  local temporary_file

  install -d -m 0700 "$${RUNTIME_DIR}"
  expected_parameters="$(jq -cn '$ARGS.positional' --args "$@")"

  temporary_file="$(mktemp "$${destination}.XXXXXX")"
  trap 'rm -f "$${temporary_file}"' RETURN
  aws ssm get-parameters-by-path --region "$${AWS_REGION}" --path "$${SSM_PATH}" --recursive \
    --with-decryption --output json |
    jq -er --arg prefix "$${SSM_PATH}/" --argjson expected "$${expected_parameters}" '
      .Parameters as $parameters
      | [$expected[] as $name | $parameters[] | select(.Name == ($prefix + $name))
         | {name: (.Name | ltrimstr($prefix)), value: .Value}]
      | if length != ($expected | length) then error("required SSM parameter is missing") else . end
      | sort_by(.name)[]
      | "\(.name)=\(.value | gsub("\\$"; "$$") | @json)"
    ' > "$${temporary_file}"
  chmod 0600 "$${temporary_file}"
  mv "$${temporary_file}" "$${destination}"
  chmod 0600 "$${destination}"
}

write_ssm_env "$${RUNTIME_DIR}/api.env" \
  DB_URL DB_USERNAME DB_PASSWORD LANDIT_CORS_ALLOWED_ORIGINS LANDIT_AUTH_TOKEN_SECRET \
  LANDIT_AUTH_TOKEN_ACCESS_EXPIRES_IN_SECONDS LANDIT_AUTH_TOKEN_REFRESH_EXPIRES_IN_SECONDS \
  LANDIT_AUTH_OIDC_GOOGLE_AUDIENCES LANDIT_AUTH_OIDC_KAKAO_AUDIENCES \
  LANDIT_AUTH_OIDC_APPLE_AUDIENCES LANDIT_AI_CLIENT_MODE LANDIT_BE_SENTRY_DSN \
  LANDIT_GRAFANA_CLOUD_OTLP_HEADERS
sed -i 's/^LANDIT_BE_SENTRY_DSN=/SENTRY_DSN=/' "$${RUNTIME_DIR}/api.env"
sed -i 's/^LANDIT_GRAFANA_CLOUD_OTLP_HEADERS=/OTEL_EXPORTER_OTLP_HEADERS=/' "$${RUNTIME_DIR}/api.env"
printf '%s\n' "AWS_REGION=$${AWS_REGION}" >> "$${RUNTIME_DIR}/api.env"
printf '%s\n' "ENVIRONMENT=$${ENVIRONMENT}" >> "$${RUNTIME_DIR}/api.env"
printf '%s\n' "SENTRY_ENVIRONMENT=$${ENVIRONMENT}" >> "$${RUNTIME_DIR}/api.env"
printf '%s\n' 'SPRING_FLYWAY_BASELINE_ON_MIGRATE=true' >> "$${RUNTIME_DIR}/api.env"
printf '%s\n' "SPRING_PROFILES_ACTIVE=$${ENVIRONMENT}" >> "$${RUNTIME_DIR}/api.env"
printf '%s\n' "S3_BUCKET_NAME=$${APP_BUCKET_NAME}" >> "$${RUNTIME_DIR}/api.env"
printf '%s\n' "SQS_JOBS_QUEUE_URL=$${JOBS_QUEUE_URL}" >> "$${RUNTIME_DIR}/api.env"
printf '%s\n' 'LANDIT_AI_BASE_URL=http://ai:8000' >> "$${RUNTIME_DIR}/api.env"
if [[ "$${GRAFANA_OTLP_ENABLED}" == true ]]; then
  printf '%s\n' "OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=$${GRAFANA_OTLP_ENDPOINT%/}/v1/metrics" >> "$${RUNTIME_DIR}/api.env"
  printf '%s\n' 'OTEL_TRACES_EXPORTER=none' >> "$${RUNTIME_DIR}/api.env"
  printf '%s\n' 'OTEL_LOGS_EXPORTER=none' >> "$${RUNTIME_DIR}/api.env"
  printf '%s\n' 'OTEL_SERVICE_NAME=landit-be' >> "$${RUNTIME_DIR}/api.env"
  printf '%s\n' "OTEL_RESOURCE_ATTRIBUTES=service.namespace=landit,deployment.environment.name=$${ENVIRONMENT}" >> "$${RUNTIME_DIR}/api.env"
  printf '%s\n' 'MANAGEMENT_OTLP_METRICS_EXPORT_ENABLED=true' >> "$${RUNTIME_DIR}/api.env"
  printf '%s\n' 'MANAGEMENT_OTLP_METRICS_EXPORT_STEP=30s' >> "$${RUNTIME_DIR}/api.env"
fi
chmod 0600 "$${RUNTIME_DIR}/api.env"

write_ssm_env "$${RUNTIME_DIR}/ai.env" \
  DB_URL DB_USERNAME DB_PASSWORD LLM_PROVIDER OPENROUTER_BASE_URL OPENROUTER_MODEL \
  MESSAGE_FEEDBACK_MODEL MESSAGE_FEEDBACK_REVIEW_ENABLED OPENROUTER_API_KEY \
  LANDIT_AI_SENTRY_DSN LANDIT_GRAFANA_CLOUD_OTLP_HEADERS
sed -i 's/^LANDIT_AI_SENTRY_DSN=/SENTRY_DSN=/' "$${RUNTIME_DIR}/ai.env"
sed -i 's/^LANDIT_GRAFANA_CLOUD_OTLP_HEADERS=/OTEL_EXPORTER_OTLP_HEADERS=/' "$${RUNTIME_DIR}/ai.env"
printf '%s\n' "AWS_REGION=$${AWS_REGION}" >> "$${RUNTIME_DIR}/ai.env"
printf '%s\n' "ENVIRONMENT=$${ENVIRONMENT}" >> "$${RUNTIME_DIR}/ai.env"
printf '%s\n' "APP_ENV=$${ENVIRONMENT}" >> "$${RUNTIME_DIR}/ai.env"
printf '%s\n' "S3_BUCKET_NAME=$${APP_BUCKET_NAME}" >> "$${RUNTIME_DIR}/ai.env"
printf '%s\n' "SQS_JOBS_QUEUE_URL=$${JOBS_QUEUE_URL}" >> "$${RUNTIME_DIR}/ai.env"
if [[ "$${GRAFANA_OTLP_ENABLED}" == true ]]; then
  printf '%s\n' 'OTEL_METRICS_ENABLED=true' >> "$${RUNTIME_DIR}/ai.env"
  printf '%s\n' 'OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf' >> "$${RUNTIME_DIR}/ai.env"
  printf '%s\n' "OTEL_EXPORTER_OTLP_ENDPOINT=$${GRAFANA_OTLP_ENDPOINT}" >> "$${RUNTIME_DIR}/ai.env"
  printf '%s\n' 'OTEL_TRACES_EXPORTER=none' >> "$${RUNTIME_DIR}/ai.env"
  printf '%s\n' 'OTEL_LOGS_EXPORTER=none' >> "$${RUNTIME_DIR}/ai.env"
  printf '%s\n' 'OTEL_SERVICE_NAME=landit-ai' >> "$${RUNTIME_DIR}/ai.env"
  printf '%s\n' "OTEL_RESOURCE_ATTRIBUTES=service.namespace=landit,deployment.environment.name=$${ENVIRONMENT}" >> "$${RUNTIME_DIR}/ai.env"
fi
chmod 0600 "$${RUNTIME_DIR}/ai.env"
RUNTIME_ENV
chmod 0750 "$${BIN_DIR}/runtime-env"

cat > "$${BIN_DIR}/deploy-service" <<'DEPLOY_SERVICE'
#!/bin/bash
# 지정한 서비스 이미지를 직렬 배포하고 loopback health를 확인한다.
set -euo pipefail

if [[ "$${#}" -ne 2 || ! "$${1}" =~ ^(api|ai)$ || ! "$${2}" =~ ^[0-9a-f]{40}$ ]]; then
  echo 'usage: deploy-service api|ai <40-character-git-sha>' >&2
  exit 64
fi

service="$${1}"
image_tag="$${2}"
LANDIT_DIR="$${LANDIT_DIR:-/opt/landit}"
AWS_REGION="${aws_region}"
ECR_REGISTRY="${ecr_registry}"
LOCK_FILE="$${LANDIT_LOCK_FILE:-/var/lock/landit-deploy.lock}"

exec 9>"$${LOCK_FILE}"
flock -x 9

write_images_env() {
  local destination="$1"
  local api_tag="$2"
  local ai_tag="$3"

  cat > "$${destination}" <<EOF
API_IMAGE=${api_image}
AI_IMAGE=${ai_image}
API_TAG=$${api_tag}
AI_TAG=$${ai_tag}
EOF
  chmod 0644 "$${destination}"
}

wait_for_health() {
  local health_url

  if [[ "$${service}" == api ]]; then
    health_url='http://127.0.0.1:8080/actuator/health'
  else
    health_url='http://127.0.0.1:8000/health'
  fi
  for _ in $(seq 1 30); do
    if curl --fail --silent --show-error "$${health_url}" >/dev/null; then
      return 0
    fi
    sleep 2
  done
  return 1
}

rollback() {
  printf '%s\n' "$${previous_tag}" > "$${LANDIT_DIR}/$${service}.tag"
  write_images_env "$${LANDIT_DIR}/images.env" \
    "$(cat "$${LANDIT_DIR}/api.tag")" "$(cat "$${LANDIT_DIR}/ai.tag")"
  if ! docker compose --project-directory "$${LANDIT_DIR}" --env-file "$${LANDIT_DIR}/images.env" \
    -f "$${LANDIT_DIR}/compose.yml" up -d --no-deps "$${service}"; then
    echo "rollback container start failed for $${service}" >&2
    return 1
  fi
  if ! wait_for_health; then
    echo "rollback health check failed for $${service}" >&2
    return 1
  fi
  return 0
}

"$${LANDIT_DIR}/bin/runtime-env"
aws ecr get-login-password --region "$${AWS_REGION}" |
  docker login --username AWS --password-stdin "$${ECR_REGISTRY}"
previous_tag="$(cat "$${LANDIT_DIR}/$${service}.tag")"
candidate_images_env="$(mktemp "$${LANDIT_DIR}/images.env.XXXXXX")"
trap 'rm -f "$${candidate_images_env}"' EXIT
if [[ "$${service}" == api ]]; then
  write_images_env "$${candidate_images_env}" "$${image_tag}" "$(cat "$${LANDIT_DIR}/ai.tag")"
else
  write_images_env "$${candidate_images_env}" "$(cat "$${LANDIT_DIR}/api.tag")" "$${image_tag}"
fi
docker compose --project-directory "$${LANDIT_DIR}" --env-file "$${candidate_images_env}" \
  -f "$${LANDIT_DIR}/compose.yml" pull "$${service}"
printf '%s\n' "$${image_tag}" > "$${LANDIT_DIR}/$${service}.tag"
mv "$${candidate_images_env}" "$${LANDIT_DIR}/images.env"
if ! docker compose --project-directory "$${LANDIT_DIR}" --env-file "$${LANDIT_DIR}/images.env" \
  -f "$${LANDIT_DIR}/compose.yml" up -d --no-deps "$${service}"; then
  rollback || true
  exit 1
fi
if wait_for_health; then
  exit 0
fi
if rollback; then
  echo "health check failed for $${service}; restored $${previous_tag}" >&2
else
  echo "health check and rollback failed for $${service}" >&2
fi
exit 1
DEPLOY_SERVICE
chmod 0750 "$${BIN_DIR}/deploy-service"

"$${BIN_DIR}/runtime-env"
aws ecr get-login-password --region "$${AWS_REGION}" |
  docker login --username AWS --password-stdin "$${ECR_REGISTRY}"
docker compose --project-directory "$${LANDIT_DIR}" --env-file "$${LANDIT_DIR}/images.env" \
  -f "$${LANDIT_DIR}/compose.yml" pull
docker compose --project-directory "$${LANDIT_DIR}" --env-file "$${LANDIT_DIR}/images.env" \
  -f "$${LANDIT_DIR}/compose.yml" up -d

wait_for_initial_health() {
  local service="$${1}"
  local health_url="$${2}"

  for _ in $(seq 1 30); do
    if curl --fail --silent --show-error "$${health_url}" >/dev/null; then
      return 0
    fi
    sleep 2
  done
  echo "initial health check failed for $${service}" >&2
  return 1
}

wait_for_initial_health api 'http://127.0.0.1:8080/actuator/health'
wait_for_initial_health ai 'http://127.0.0.1:8000/health'

cat > /opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json <<'CLOUDWATCH'
{
  "metrics": {
    "namespace": "Landit/EC2",
    "append_dimensions": {
      "InstanceId": "$${aws:InstanceId}"
    },
    "metrics_collected": {
      "cpu": {
        "measurement": ["cpu_usage_idle"],
        "totalcpu": true
      },
      "disk": {
        "measurement": ["used_percent"],
        "resources": ["/"]
      },
      "mem": {
        "measurement": ["mem_used_percent"]
      },
      "swap": {
        "measurement": ["swap_used_percent"]
      }
    }
  }
}
CLOUDWATCH
/opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl \
  -a fetch-config -m ec2 -s \
  -c file:/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json
